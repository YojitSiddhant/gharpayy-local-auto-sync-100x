NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Comma-separated hostnames accepted by the Next.js proxy. Set the Render frontend hostname in production.
NEXT_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],::1
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
DATABASE_URL=mysql+pymysql://username:password@127.0.0.1:3306/gharpayy_local_sync
# Server-only shared secret (Next.js proxy -> FastAPI). Never prefix with NEXT_PUBLIC_.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
LOCAL_API_TOKEN=
# Optional overrides (defaults shown)
# BACKEND_INTERNAL_URL=http://127.0.0.1:8000
# OCR_MAX_UPLOAD_BYTES=10485760
# OCR_MAX_IMAGE_PIXELS=25000000
# OCR_TESSERACT_TIMEOUT_SECONDS=20
# SCREENSHOT_STORAGE_DIR=backend/.private_storage/screenshots
# SCREENSHOT_RETENTION_ENABLED=true
# Reversible retention: move evidence older than N days to Trash via `python -m backend.app.ocr.retention --apply`. 0 = off.
# EVIDENCE_RETENTION_DAYS=0
