# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
/backend/.env
/.venv/
/backend/.venv/
# private OCR screenshot evidence (never commit)
/backend/.private_storage/
# ML datasets and artifacts are private by default; only the committed synthetic
# fixture and directory placeholders below are allowlisted.
/backend/training/datasets/*
!/backend/training/datasets/.gitkeep
!/backend/training/datasets/synthetic/
!/backend/training/datasets/synthetic/labels.json
/backend/training/private/
/backend/training/outputs/
/backend/model_artifacts/
__pycache__/
.pytest_cache/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
references/
.venv-paddle/
