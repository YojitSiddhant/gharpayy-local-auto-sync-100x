APP_ENV=development
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
BACKEND_ALLOWED_HOSTS=["localhost","127.0.0.1","::1"]
DATABASE_URL=mysql+pymysql://username:password@127.0.0.1:3306/gharpayy_local_sync
LOCAL_API_TOKEN=
## Render Docker runtime: provide the Aiven CA as a secret environment value.
# AIVEN_CA_CERT_PATH=/run/secrets/aiven-ca.pem
# DATABASE_URL=mysql+pymysql://username:password@aiven-host:aiven-port/database?ssl_ca=%2Frun%2Fsecrets%2Faiven-ca.pem&ssl_check_hostname=true
OCR_PROCESSING_MODE=LOCAL_ONLY
OCR_SINGLE_PROVIDER=
OCR_EXTERNAL_TRANSMISSION_ENABLED=false
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_VISION_MODEL=qwen/qwen3.8-27b
OCR_CLOUD_REQUEST_BUDGET=2
OCR_CLOUD_TIMEOUT_SECONDS=15
